<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="org.example.ChessController"
           fx:id="rootStack"
           prefHeight="820.0" prefWidth="1120.0"
           style="-fx-background-color: #1e1e1e;">

    <BorderPane style="-fx-padding: 20;">

        <top>
            <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 0 0 12 0;">
                <Button fx:id="hamburgerButton" text="☰" style="-fx-background-color: #262421; -fx-text-fill: #ffffff; -fx-font-size: 20px; -fx-font-weight: bold; -fx-padding: 6 14 6 14; -fx-background-radius: 8; -fx-cursor: hand;"/>
                <Label text="Shatranj" style="-fx-text-fill: #e8e8e8; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                <Label text="by Group 1" style="-fx-text-fill: #81b64c; -fx-font-size: 14px; -fx-font-style: italic;"/>
            </HBox>
        </top>

        <center>
            <HBox spacing="24" alignment="CENTER">
                <StackPane minWidth="664" minHeight="664" maxWidth="664" maxHeight="664"
                           style="-fx-background-color: #312e2b; -fx-background-radius: 10; -fx-padding: 12;">
                    <GridPane fx:id="boardGrid" alignment="CENTER">
                        <StackPane fx:id="cell_0_0" prefWidth="80" prefHeight="80" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <StackPane fx:id="cell_0_1" prefWidth="80" prefHeight="80" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        <StackPane fx:id="cell_0_2" prefWidth="80" prefHeight="80" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                        <StackPane fx:id="cell_0_3" prefWidth="80" prefHeight="80" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
                        <StackPane fx:id="cell_0_4" prefWidth="80" prefHeight="80" GridPane.rowIndex="0" GridPane.columnIndex="4"/>
                        <StackPane fx:id="cell_0_5" prefWidth="80" prefHeight="80" GridPane.rowIndex="0" GridPane.columnIndex="5"/>
                        <StackPane fx:id="cell_0_6" prefWidth="80" prefHeight="80" GridPane.rowIndex="0" GridPane.columnIndex="6"/>
                        <StackPane fx:id="cell_0_7" prefWidth="80" prefHeight="80" GridPane.rowIndex="0" GridPane.columnIndex="7"/>

                        <StackPane fx:id="cell_1_0" prefWidth="80" prefHeight="80" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <StackPane fx:id="cell_1_1" prefWidth="80" prefHeight="80" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        <StackPane fx:id="cell_1_2" prefWidth="80" prefHeight="80" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                        <StackPane fx:id="cell_1_3" prefWidth="80" prefHeight="80" GridPane.rowIndex="1" GridPane.columnIndex="3"/>
                        <StackPane fx:id="cell_1_4" prefWidth="80" prefHeight="80" GridPane.rowIndex="1" GridPane.columnIndex="4"/>
                        <StackPane fx:id="cell_1_5" prefWidth="80" prefHeight="80" GridPane.rowIndex="1" GridPane.columnIndex="5"/>
                        <StackPane fx:id="cell_1_6" prefWidth="80" prefHeight="80" GridPane.rowIndex="1" GridPane.columnIndex="6"/>
                        <StackPane fx:id="cell_1_7" prefWidth="80" prefHeight="80" GridPane.rowIndex="1" GridPane.columnIndex="7"/>

                        <StackPane fx:id="cell_2_0" prefWidth="80" prefHeight="80" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <StackPane fx:id="cell_2_1" prefWidth="80" prefHeight="80" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                        <StackPane fx:id="cell_2_2" prefWidth="80" prefHeight="80" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
                        <StackPane fx:id="cell_2_3" prefWidth="80" prefHeight="80" GridPane.rowIndex="2" GridPane.columnIndex="3"/>
                        <StackPane fx:id="cell_2_4" prefWidth="80" prefHeight="80" GridPane.rowIndex="2" GridPane.columnIndex="4"/>
                        <StackPane fx:id="cell_2_5" prefWidth="80" prefHeight="80" GridPane.rowIndex="2" GridPane.columnIndex="5"/>
                        <StackPane fx:id="cell_2_6" prefWidth="80" prefHeight="80" GridPane.rowIndex="2" GridPane.columnIndex="6"/>
                        <StackPane fx:id="cell_2_7" prefWidth="80" prefHeight="80" GridPane.rowIndex="2" GridPane.columnIndex="7"/>

                        <StackPane fx:id="cell_3_0" prefWidth="80" prefHeight="80" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <StackPane fx:id="cell_3_1" prefWidth="80" prefHeight="80" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                        <StackPane fx:id="cell_3_2" prefWidth="80" prefHeight="80" GridPane.rowIndex="3" GridPane.columnIndex="2"/>
                        <StackPane fx:id="cell_3_3" prefWidth="80" prefHeight="80" GridPane.rowIndex="3" GridPane.columnIndex="3"/>
                        <StackPane fx:id="cell_3_4" prefWidth="80" prefHeight="80" GridPane.rowIndex="3" GridPane.columnIndex="4"/>
                        <StackPane fx:id="cell_3_5" prefWidth="80" prefHeight="80" GridPane.rowIndex="3" GridPane.columnIndex="5"/>
                        <StackPane fx:id="cell_3_6" prefWidth="80" prefHeight="80" GridPane.rowIndex="3" GridPane.columnIndex="6"/>
                        <StackPane fx:id="cell_3_7" prefWidth="80" prefHeight="80" GridPane.rowIndex="3" GridPane.columnIndex="7"/>

                        <StackPane fx:id="cell_4_0" prefWidth="80" prefHeight="80" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        <StackPane fx:id="cell_4_1" prefWidth="80" prefHeight="80" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                        <StackPane fx:id="cell_4_2" prefWidth="80" prefHeight="80" GridPane.rowIndex="4" GridPane.columnIndex="2"/>
                        <StackPane fx:id="cell_4_3" prefWidth="80" prefHeight="80" GridPane.rowIndex="4" GridPane.columnIndex="3"/>
                        <StackPane fx:id="cell_4_4" prefWidth="80" prefHeight="80" GridPane.rowIndex="4" GridPane.columnIndex="4"/>
                        <StackPane fx:id="cell_4_5" prefWidth="80" prefHeight="80" GridPane.rowIndex="4" GridPane.columnIndex="5"/>
                        <StackPane fx:id="cell_4_6" prefWidth="80" prefHeight="80" GridPane.rowIndex="4" GridPane.columnIndex="6"/>
                        <StackPane fx:id="cell_4_7" prefWidth="80" prefHeight="80" GridPane.rowIndex="4" GridPane.columnIndex="7"/>

                        <StackPane fx:id="cell_5_0" prefWidth="80" prefHeight="80" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                        <StackPane fx:id="cell_5_1" prefWidth="80" prefHeight="80" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                        <StackPane fx:id="cell_5_2" prefWidth="80" prefHeight="80" GridPane.rowIndex="5" GridPane.columnIndex="2"/>
                        <StackPane fx:id="cell_5_3" prefWidth="80" prefHeight="80" GridPane.rowIndex="5" GridPane.columnIndex="3"/>
                        <StackPane fx:id="cell_5_4" prefWidth="80" prefHeight="80" GridPane.rowIndex="5" GridPane.columnIndex="4"/>
                        <StackPane fx:id="cell_5_5" prefWidth="80" prefHeight="80" GridPane.rowIndex="5" GridPane.columnIndex="5"/>
                        <StackPane fx:id="cell_5_6" prefWidth="80" prefHeight="80" GridPane.rowIndex="5" GridPane.columnIndex="6"/>
                        <StackPane fx:id="cell_5_7" prefWidth="80" prefHeight="80" GridPane.rowIndex="5" GridPane.columnIndex="7"/>

                        <StackPane fx:id="cell_6_0" prefWidth="80" prefHeight="80" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                        <StackPane fx:id="cell_6_1" prefWidth="80" prefHeight="80" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
                        <StackPane fx:id="cell_6_2" prefWidth="80" prefHeight="80" GridPane.rowIndex="6" GridPane.columnIndex="2"/>
                        <StackPane fx:id="cell_6_3" prefWidth="80" prefHeight="80" GridPane.rowIndex="6" GridPane.columnIndex="3"/>
                        <StackPane fx:id="cell_6_4" prefWidth="80" prefHeight="80" GridPane.rowIndex="6" GridPane.columnIndex="4"/>
                        <StackPane fx:id="cell_6_5" prefWidth="80" prefHeight="80" GridPane.rowIndex="6" GridPane.columnIndex="5"/>
                        <StackPane fx:id="cell_6_6" prefWidth="80" prefHeight="80" GridPane.rowIndex="6" GridPane.columnIndex="6"/>
                        <StackPane fx:id="cell_6_7" prefWidth="80" prefHeight="80" GridPane.rowIndex="6" GridPane.columnIndex="7"/>

                        <StackPane fx:id="cell_7_0" prefWidth="80" prefHeight="80" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                        <StackPane fx:id="cell_7_1" prefWidth="80" prefHeight="80" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
                        <StackPane fx:id="cell_7_2" prefWidth="80" prefHeight="80" GridPane.rowIndex="7" GridPane.columnIndex="2"/>
                        <StackPane fx:id="cell_7_3" prefWidth="80" prefHeight="80" GridPane.rowIndex="7" GridPane.columnIndex="3"/>
                        <StackPane fx:id="cell_7_4" prefWidth="80" prefHeight="80" GridPane.rowIndex="7" GridPane.columnIndex="4"/>
                        <StackPane fx:id="cell_7_5" prefWidth="80" prefHeight="80" GridPane.rowIndex="7" GridPane.columnIndex="5"/>
                        <StackPane fx:id="cell_7_6" prefWidth="80" prefHeight="80" GridPane.rowIndex="7" GridPane.columnIndex="6"/>
                        <StackPane fx:id="cell_7_7" prefWidth="80" prefHeight="80" GridPane.rowIndex="7" GridPane.columnIndex="7"/>
                    </GridPane>
                </StackPane>

                <VBox spacing="10" prefWidth="220">
                    <Button fx:id="premoveToggle" maxWidth="Infinity" style="-fx-background-color: #3a3a3a; -fx-text-fill: #ffffff; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12; -fx-background-radius: 8; -fx-cursor: hand;"/>

                    <VBox spacing="6" style="-fx-background-color: #262421; -fx-background-radius: 10; -fx-padding: 12;">
                        <Label text="BLACK" style="-fx-text-fill: #9a9a9a; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                        <Label fx:id="blackClockLabel" text="03:00" style="-fx-text-fill: #ffffff; -fx-font-size: 34px; -fx-font-weight: bold;"/>
                    </VBox>

                    <VBox spacing="6" style="-fx-background-color: #262421; -fx-background-radius: 10; -fx-padding: 12;">
                        <Label text="WHITE" style="-fx-text-fill: #9a9a9a; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                        <Label fx:id="whiteClockLabel" text="03:00" style="-fx-text-fill: #ffffff; -fx-font-size: 34px; -fx-font-weight: bold;"/>
                    </VBox>

                    <VBox spacing="4" style="-fx-background-color: #262421; -fx-background-radius: 10; -fx-padding: 12;">
                        <Label text="CAPTURED PIECES" style="-fx-text-fill: #9a9a9a; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                        <Label text="White captured:" style="-fx-text-fill: #e8e8e8; -fx-font-size: 12px;"/>
                        <Label fx:id="whiteCapturedLabel" text="None" style="-fx-text-fill: #ffffff; -fx-font-family: 'Segoe UI Symbol'; -fx-font-size: 18px;"/>

                        <Label text="Black captured:" style="-fx-text-fill: #e8e8e8; -fx-font-size: 12px; -fx-padding: 6 0 0 0;"/>
                        <Label fx:id="blackCapturedLabel" text="None" style="-fx-text-fill: #ffffff; -fx-font-family: 'Segoe UI Symbol'; -fx-font-size: 18px;"/>
                    </VBox>

                    <VBox spacing="6" style="-fx-background-color: #262421; -fx-background-radius: 10; -fx-padding: 12;">
                        <Label text="PLAY AS" style="-fx-text-fill: #9a9a9a; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                        <HBox spacing="6">
                            <Button fx:id="playAsWhiteButton" text="White" maxWidth="Infinity" HBox.hgrow="ALWAYS" style="-fx-background-color: #3a3a3a; -fx-text-fill: #ffffff; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 10; -fx-background-radius: 8; -fx-cursor: hand;"/>
                            <Button fx:id="playAsBlackButton" text="Black" maxWidth="Infinity" HBox.hgrow="ALWAYS" style="-fx-background-color: #3a3a3a; -fx-text-fill: #ffffff; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 10; -fx-background-radius: 8; -fx-cursor: hand;"/>
                        </HBox>
                    </VBox>

                    <Button fx:id="undoButton" text="Undo Last Move" maxWidth="Infinity" style="-fx-background-color: #3a3a3a; -fx-text-fill: #6a6a6a; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12; -fx-background-radius: 10;"/>

                    <VBox spacing="4" VBox.vgrow="ALWAYS" style="-fx-background-color: #262421; -fx-background-radius: 10; -fx-padding: 12;">
                        <Label text="MOVES" style="-fx-text-fill: #9a9a9a; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                            <VBox fx:id="movesList" spacing="2" style="-fx-background-color: transparent;"/>
                        </ScrollPane>
                    </VBox>
                </VBox>
            </HBox>
        </center>

        <bottom>
            <HBox alignment="CENTER" spacing="20.0" style="-fx-padding: 12 0 0 0;">
                <Label fx:id="statusLabel" text="White to move" style="-fx-text-fill: #e8e8e8; -fx-font-size: 16px;"/>
            </HBox>
        </bottom>

    </BorderPane>

    <StackPane fx:id="startScreenOverlay" style="-fx-background-color: #1e1e1e;">
        <HBox alignment="CENTER" spacing="20">
            <!-- Left Knight -->
            <Label text="♘" style="-fx-text-fill: #262421; -fx-font-family: 'Segoe UI Symbol'; -fx-font-size: 250px; -fx-translate-y: -50;"/>

            <!-- Center Title and Buttons -->
            <VBox alignment="CENTER" spacing="15" minWidth="450" style="-fx-padding: 40;">
                <Label text="SHATRANJ" style="-fx-text-fill: #f5c542; -fx-font-size: 52px; -fx-font-weight: bold;"/>
                <Label text="by Group 1" style="-fx-text-fill: #81b64c; -fx-font-size: 20px; -fx-font-style: italic; -fx-padding: 0 0 20 0;"/>

                <Button fx:id="startButton" text="Start Game" maxWidth="Infinity" prefHeight="50" style="-fx-background-color: #81b64c; -fx-text-fill: #ffffff; -fx-font-size: 17px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;"/>
                <Button fx:id="continueButton" text="Continue" maxWidth="Infinity" prefHeight="50" style="-fx-background-color: #3a3a3a; -fx-text-fill: #ffffff; -fx-font-size: 17px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;"/>
                <Button fx:id="quitButton" text="Quit" maxWidth="Infinity" prefHeight="50" style="-fx-background-color: #c05242; -fx-text-fill: #ffffff; -fx-font-size: 17px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;"/>
            </VBox>

            <!-- Right Knight -->
            <Label text="♞" style="-fx-text-fill: #262421; -fx-font-family: 'Segoe UI Symbol'; -fx-font-size: 250px; -fx-translate-y: -50;"/>
        </HBox>
    </StackPane>

    <StackPane fx:id="gameOverOverlay" visible="false" style="-fx-background-color: rgba(0, 0, 0, 0.65);">
        <VBox alignment="CENTER" spacing="14" prefWidth="360" prefHeight="340" maxWidth="360" maxHeight="340" style="-fx-background-color: #312e2b; -fx-background-radius: 14; -fx-padding: 32 48 32 48;">
            <Label fx:id="popupTitleLabel" text="CHECKMATE" style="-fx-text-fill: #f5c542; -fx-font-size: 28px; -fx-font-weight: bold;"/>
            <Label fx:id="popupMessageLabel" text="White wins!" style="-fx-text-fill: #e8e8e8; -fx-font-size: 18px;"/>
            <Label fx:id="popupTimeLabel" text="Time used — White: 00:00 Black: 00:00" style="-fx-text-fill: #9a9a9a; -fx-font-size: 12px;"/>

            <Button fx:id="popupNewGameButton" text="New Game" maxWidth="Infinity" style="-fx-background-color: #81b64c; -fx-text-fill: #ffffff; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 12 20 12 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
            <Button fx:id="popupViewBoardButton" text="View Board" maxWidth="Infinity" style="-fx-background-color: #3a3a3a; -fx-text-fill: #e0e0e0; -fx-font-size: 15px; -fx-padding: 12 20 12 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
            <Button fx:id="popupQuitButton" text="Quit to Menu" maxWidth="Infinity" style="-fx-background-color: #c05242; -fx-text-fill: #ffffff; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 12 20 12 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
        </VBox>
    </StackPane>

</StackPane>